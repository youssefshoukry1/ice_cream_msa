# Sanity catalog. The app uses the shared project settings if these are omitted.
SANITY_PROJECT_ID=ybya68i2
SANITY_DATASET=production

# Optional server-only read token if the catalog dataset requires authentication.
# SANITY_READ_TOKEN=
# Server-only viewer credential for the /menue draft preview.
# SANITY_MENU_PREVIEW_TOKEN=

# Stripe Sandbox. Enter the secret only in .env.local or server-side hosting settings.
STRIPE_SECRET_KEY=
# CHECKOUT_ORIGIN=http://localhost:3000
# CHECKOUT_PAUSED=true
STRIPE_WEBHOOK_SECRET=

# Separate private dataset in the configured Sanity project. Keep the token server-only.
# SANITY_ORDERS_DATASET=orders-sandbox
SANITY_ORDERS_TOKEN=
